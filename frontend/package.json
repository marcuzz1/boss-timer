{
  "name": "boss-timer-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "巡王計時器前端（React + Vite，桌機版與手機版兩個入口）",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
